---
import Layout from '../layouts/Layout.astro';
import JournalForm from '../components/JournalForm.astro';
---

<Layout title="Outdoor Journal | Local-First AI">
  <main class="container">
    <header class="header">
      <span class="badge">Write & Connect</span>
      <h1>Outdoor Journal</h1>
      <p class="subtitle">Capture the sensations, aromas, and thoughts of your walks outdoors.</p>
    </header>

    <JournalForm />
  </main>
</Layout>

<style>
  .container {
    max-width: 620px;
    width: 100%;
  }

  .header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-sage);
    background-color: #f0f4f1;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-weight: 500;
    margin-bottom: 0.8rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2.2rem;
    color: var(--text-main);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
    font-weight: 300;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 1.8rem;
    }
  }
</style>